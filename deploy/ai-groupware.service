[Unit]
Description=AI Groupware shared server
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=ryanlen
WorkingDirectory=/home/ryanlen/project/ai-groupware
ExecStart=/usr/bin/python3 /home/ryanlen/project/ai-groupware/server.py
Environment=GW_PORT=8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
